# 仓库内统一按文本处理，行尾一律 LF（避免中文文件出现整份 diff）
* text=auto eol=lf

# 中文文档按文本 diff
*.md  text
*.html text
*.svg text

# Windows 脚本保留 CRLF（日后加部署脚本时才不至于出错）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
